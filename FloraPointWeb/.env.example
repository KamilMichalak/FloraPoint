# Skopiuj ten plik do .env.local i wypełnij prawdziwymi wartościami.
# .env.local nigdy nie trafia do repo (patrz .gitignore).

# Adres FloraPointAPI. Lokalnie: http://localhost:5226 (patrz launchSettings.json w FloraPointAPI).
# Zobacz issue #10 w sprawie adresu produkcyjnego.
VITE_API_BASE_URL=http://localhost:5226

# Konfiguracja Firebase (ten sam projekt co FloraPointAPI/mobile: florapoint-6390f).
# Pobierz z konsoli Firebase: Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=florapoint-6390f
